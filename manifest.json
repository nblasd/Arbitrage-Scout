{
  "manifest_version": 3,
  "name": "Arbitrage Scout — Amazon ⇄ eBay Comparator",
  "short_name": "Arbitrage Scout",
  "version": "1.2.0",
  "description": "Searches the same product on Amazon and eBay, matches similar listings, and estimates resale profit after marketplace fees. Paste an eBay item URL to analyze a single product against Amazon.",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://www.amazon.com/*",
    "https://www.ebay.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Arbitrage Scout",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com/*",
        "https://www.ebay.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.ebay.com/itm/*",
        "https://*.ebay.com/itm/*"
      ],
      "js": ["ebay2amazon.js", "content-item.js"],
      "run_at": "document_idle"
    }
  ]
}
